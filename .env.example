# Server Network Settings
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=replace_with_a_cryptographically_secure_random_key_64_characters_min
ADMIN_SESSION_HOURS=12

# Database Configuration (PostgreSQL Production / SQLite Local Fallback)
# For Production PostgreSQL (Isolated from Odoo's internal database!):
DATABASE_URL=postgresql://gmg_user:secure_password@localhost:5432/gmg_ecommerce_db
# For Local Development SQLite:
DATABASE_PATH=./data/store.db

# Odoo 19 Community ERP VPS Integration
# Note: Keep ODOO_MODE=mock for local development and automated CI/CD tests!
ODOO_MODE=mock
ODOO_URL=https://odoo19.vps.example.om
ODOO_DB=odoo19_production
ODOO_USERNAME=ecommerce_retail_api@company.om
ODOO_API_KEY=your_least_privilege_retail_odoo19_api_token
ODOO_RETAIL_COMPANY_ID=1
ODOO_WHOLESALE_COMPANY_ID=2
ODOO_RETAIL_PRICELIST_ID=1
ODOO_RETAIL_WAREHOUSE_ID=1
ODOO_TIMEOUT_MS=15000

# Thawani Payment Gateway (Oman Central Bank Licensed)
# Mode: sandbox (UAT) or live (Production)
THAWANI_MODE=sandbox
THAWANI_PUBLIC_KEY=hgViMusdnkgKc8ymxServiceKeyUAT
THAWANI_SECRET_KEY=rRQ27ugXZTGvposProcessSecretKeyUAT
THAWANI_WEBHOOK_SECRET=your_thawani_webhook_secret_here

# Oman Fiscal Defaults
STORE_CURRENCY=OMR
STORE_VAT_RATE=0.05
FREE_SHIPPING_THRESHOLD_BAISA=25000
MUSCAT_DELIVERY_FEE_BAISA=1500
OTHER_DELIVERY_FEE_BAISA=2500
